{
  "name": "typescript-todo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile:manual": "tsc manual-compile/basics.ts --outDir manual-compile/dist --target ES2020 && node manual-compile/dist/basics.js",
    "test:e2e": "testcafe \"chrome:headless\" tests/e2e/ --app \"npx vite preview --port 4174 --strictPort\" --app-init-delay 4000",
    "test:e2e:remote": "testcafe \"chrome:headless\" tests/e2e/"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "testcafe": "^3.7.7",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
